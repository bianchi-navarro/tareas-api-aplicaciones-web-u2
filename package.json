{
  "name": "tareas-api-u2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de tareas con SQLite, sesiones persistentes y eventos SSE - Aplicaciones Web U2",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "test": "node --experimental-test-isolation=none --test --test-concurrency=1",
    "test:coverage": "node --experimental-test-isolation=none --experimental-test-coverage --test --test-concurrency=1"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  }
}
